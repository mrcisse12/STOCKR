{
  "name": "Engram — flashcards IA",
  "short_name": "Engram",
  "description": "Photographiez votre cours, retenez-le pour toujours. Flashcards IA, répétition espacée FSRS, réponses au stylet corrigées par l'IA.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0D1411",
  "theme_color": "#0D1411",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Réviser", "url": "./#study", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scanner un cours", "url": "./#scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
